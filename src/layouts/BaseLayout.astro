---
import Nav from "@components/Nav.astro";
import { SITE } from "../config/site";
import {
  alternateUrls,
  getMessages,
  localeFromUrl,
  localeMetadata,
  pagePath,
  pageUrl,
  type Locale,
  type PageId,
} from "../i18n";
import "@styles/content.css";
import "@styles/fonts.css";
import "@styles/global.css";

/** @brief 基础页面布局属性 (Base page layout properties)。 */
interface Props {
  /** @brief 当前页面语言 (Active page locale)。 */
  locale?: Locale;
  /** @brief 当前可索引页面标识 (Current indexable page identifier)。 */
  page?: PageId;
  /** @brief 页面短标题 (Short page title)。 */
  title?: string;
  /** @brief 内容页的页面短标题别名 (Short page-title alias for content pages)。 */
  pageTitle?: string;
  /** @brief 页面摘要 (Page description)。 */
  description?: string;
  /** @brief 规范地址或站内路径 (Canonical URL or site-relative path)。 */
  canonical?: string;
  /** @brief 分享图地址 (Social sharing image URL)。 */
  image?: string;
  /** @brief 搜索引擎抓取指令 (Crawler directives)。 */
  robots?: string;
  /** @brief body 的附加类名 (Additional body class)。 */
  class?: string;
}

/** @brief 页面传入属性 (Incoming page properties)。 */
const props = Astro.props as Props;
/** @brief 当前页面语言 (Active page locale)。 */
const locale = props.locale ?? localeFromUrl(Astro.url);
/** @brief 当前语言元数据 (Metadata for the active locale)。 */
const language = localeMetadata[locale];
/** @brief 当前语言文案 (Messages for the active locale)。 */
const copy = getMessages(locale);
/** @brief 站点一级页面的稳定顺序 (Stable order of primary site pages)。 */
const pages = ["home", "uses", "now", "projects", "contact"] as const satisfies readonly PageId[];
/** @brief 去除语言前缀与尾斜杠后的当前路径 (Current path without locale prefix or trailing slash)。 */
const localPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "").replace(/\/+$/, "") || "/";
/** @brief 当前页面标识，未传入时从地址推导 (Current page identifier, inferred from the URL when omitted)。 */
const page =
  props.page ??
  pages.find((candidate) => (pagePath(candidate, "zh").replace(/\/+$/, "") || "/") === localPath);
/** @brief 页面最终短标题 (Resolved short page title)。 */
const resolvedTitle = props.title ?? props.pageTitle ?? (page ? copy.meta[page].title : undefined);
/** @brief 页面最终摘要 (Resolved page description)。 */
const description =
  props.description ?? (page ? copy.meta[page].description : copy.meta.home.description);
/** @brief 浏览器与分享平台使用的完整标题 (Full document and social title)。 */
const documentTitle = resolvedTitle ? `${resolvedTitle} — ${SITE.title}` : SITE.title;
/** @brief 站点绝对地址基准 (Absolute site URL base)。 */
const siteUrl = Astro.site ?? new URL(SITE.url);
/** @brief 当前页面规范地址 (Canonical URL for the current page)。 */
const canonicalUrl = props.canonical
  ? new URL(props.canonical, siteUrl).toString()
  : page
    ? pageUrl(page, locale, siteUrl)
    : new URL(Astro.url.pathname, siteUrl).toString();
/** @brief 页面语言替代地址 (Language-alternate URLs for the current page)。 */
const alternates = page ? alternateUrls(page, siteUrl) : [];
/** @brief 分享图绝对地址，未传入时使用品牌卡片 (Absolute social image URL, using the brand card by default)。 */
const socialImage = new URL(props.image ?? "/social-card.png", siteUrl).toString();
/** @brief 分享图结构化数据标识 (Structured-data identifier for the social image)。 */
const socialImageId = `${socialImage}#image`;
/** @brief 当前年份 (Current year)。 */
const currentYear = new Date().getFullYear();
/** @brief 个人身份结构化数据 (Person structured data)。 */
const person = {
  "@type": "Person",
  "@id": `${new URL("/", siteUrl)}#person`,
  name: SITE.name,
  url: new URL("/", siteUrl).toString(),
  sameAs: [SITE.githubUrl, SITE.blogUrl],
};
/** @brief 当前文档结构化数据图 (Structured-data graph for the current document)。 */
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": page === "home" ? "ProfilePage" : "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: documentTitle,
      description,
      inLanguage: language.languageTag,
      isPartOf: { "@id": `${new URL("/", siteUrl)}#website` },
      image: { "@id": socialImageId },
      primaryImageOfPage: { "@id": socialImageId },
      ...(page === "home" ? { mainEntity: { "@id": person["@id"] } } : {}),
    },
    {
      "@type": "ImageObject",
      "@id": socialImageId,
      url: socialImage,
      contentUrl: socialImage,
      width: 1200,
      height: 630,
      caption: `${SITE.name} — ${copy.brand.tagline}`,
      inLanguage: language.languageTag,
    },
    {
      "@type": "WebSite",
      "@id": `${new URL("/", siteUrl)}#website`,
      url: new URL("/", siteUrl).toString(),
      name: SITE.title,
      inLanguage: ["zh-CN", "en-US"],
      publisher: { "@id": person["@id"] },
    },
  ],
};
---

<!doctype html>
<html lang={language.languageTag} dir={language.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fff6ea" />
    <script is:inline>
      (() => {
        /** @brief 主题本地存储键 (Local-storage key for the theme)。 */
        const storageKey = "site-theme";
        /** @brief 文档根元素 (Document root element)。 */
        const root = document.documentElement;
        /** @brief 已保存主题 (Saved theme)。 */
        let savedTheme = null;
        try { savedTheme = localStorage.getItem(storageKey); } catch { /* 受限容器回退至系统偏好 (Fall back to system preference in restricted containers). */ }
        /** @brief 系统深色偏好 (System dark-color preference)。 */
        const systemDark = typeof matchMedia === "function" && matchMedia("(prefers-color-scheme: dark)").matches;
        /** @brief 首次绘制采用的主题 (Theme used for the first paint)。 */
        const theme = savedTheme === "light" || savedTheme === "dark" ? savedTheme : systemDark ? "dark" : "light";
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <meta name="description" content={description} />
    {props.robots && <meta name="robots" content={props.robots} />}
    <meta property="og:type" content={page === "home" ? "profile" : "website"} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={language.openGraphLocale} />
    {Object.values(localeMetadata).filter((item) => item.id !== locale).map((item) => <meta property="og:locale:alternate" content={item.openGraphLocale} />)}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${copy.brand.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${copy.brand.tagline}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{documentTitle}</title>
  </head>
  <body class={props.class}>
    <a class="skip-link" href="#main-content">{copy.common.skipToContent}</a>
    <div class="site-shell">
      <header class="site-header container">
        <Nav {locale} {...(page ? { page } : {})} />
      </header>
      <main id="main-content" class="site-main container" tabindex="-1"><slot /></main>
      <footer class="site-footer container">
        <span>© {SITE.startYear}–{currentYear} {SITE.name} ✦</span>
        <span>{copy.common.builtWith} · <a href={SITE.githubUrl}>GitHub</a></span>
      </footer>
    </div>
    <script is:inline>
      (() => {
        /** @brief 请求减少动态效果的媒体查询 (Media query requesting reduced motion)。 */
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        if (reducedMotion.matches || typeof IntersectionObserver !== "function") return;

        /** @brief 需要一次性显现的页面区块 (Page sections requiring a one-time reveal)。 */
        const elements = [...document.querySelectorAll("[data-reveal]")];
        if (elements.length === 0) return;

        /** @brief 区块进入视口时触发的共享观察器 (Shared observer triggered when sections enter the viewport)。 */
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8%", threshold: 0.08 },
        );

        document.documentElement.classList.add("motion-ready");
        for (const element of elements) observer.observe(element);
      })();
    </script>
  </body>
</html>
