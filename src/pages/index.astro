---
import { getCollection, render } from "astro:content";
import MarkdownPage from "../components/MarkdownPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

/** @brief GitHub Profile README 内容条目 / GitHub Profile README content entry. */
const profileEntry = (await getCollection("profile"))[0];

if (!profileEntry) {
  throw new Error("README.md is required to build the home page.");
}

/** @brief 渲染后的个人资料内容 / Rendered profile content. */
const { Content } = await render(profileEntry);
---

<BaseLayout
	title="MoeSegfault"
	description="Klee's personal home for software systems, research, projects, and a little bit of moe."
>
	<div class="page-shell home-shell">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__copy">
				<p class="eyebrow">Computer scientist · Systems builder</p>
				<h1 id="hero-title">Hi, I’m Klee.<br /><span>I turn ideas into systems.</span></h1>
				<p class="hero__lede">
					I build software, explore agent-native research workflows, and document the useful evidence along the way.
				</p>
				<div class="hero__actions" aria-label="Profile links">
					<a class="button" href="https://github.com/kleedaisuki">GitHub Profile <span aria-hidden="true">↗</span></a>
					<a class="button button--ghost" href="/projects/">Explore projects</a>
				</div>
			</div>

			<nav class="destinations" aria-label="Featured destinations">
				<a class="destination destination--bot" href="https://bot.moesegfault.dev">
					<span class="destination__index" aria-hidden="true">01</span>
					<span class="destination__body">
						<strong>FOGMOE Bot</strong>
						<small>Meet the agent system</small>
					</span>
					<span class="destination__arrow" aria-hidden="true">↗</span>
				</a>
				<a class="destination destination--blog" href="https://blog.moesegfault.dev">
					<span class="destination__index" aria-hidden="true">02</span>
					<span class="destination__body">
						<strong>Blog & Notes</strong>
						<small>Read the evolving archive</small>
					</span>
					<span class="destination__arrow" aria-hidden="true">↗</span>
				</a>
			</nav>
		</section>

		<section class="profile-copy" aria-label="About Klee">
			<MarkdownPage
				Content={Content}
				eyebrow="GitHub Profile · Synced from README"
				sourceHref="https://github.com/kleedaisuki/kleedaisuki/blob/main/README.md"
			/>
		</section>
	</div>
</BaseLayout>

<style>
	.home-shell {
		display: grid;
		gap: clamp(4rem, 10vw, 8rem);
		width: 100%;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
		gap: clamp(2.5rem, 8vw, 7rem);
		align-items: end;
		min-height: min(42rem, calc(100svh - 10rem));
		padding-block: clamp(3rem, 9vw, 7rem);
	}

	.hero h1 {
		max-width: 12ch;
		margin: 0.75rem 0 1.5rem;
		font-size: clamp(3rem, 8.5vw, 7rem);
		line-height: 0.93;
		letter-spacing: -0.065em;
	}

	.hero h1 span {
		color: var(--coral-strong);
	}

	.hero__lede {
		max-width: 57ch;
		margin: 0;
		color: var(--text-soft);
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.7;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 2rem;
	}

	.destinations {
		display: grid;
		gap: 0.8rem;
	}

	.destination {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-medium);
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.destination:hover {
		transform: translateY(-3px);
		border-color: var(--coral);
		box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--coral) 13%, transparent);
	}

	.destination__index,
	.destination__arrow,
	.destination__body small {
		color: var(--text-soft);
	}

	.destination__index {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
	}

	.destination__body {
		display: grid;
		gap: 0.25rem;
	}

	.destination__body strong {
		font-size: 1rem;
	}

	.destination__body small {
		font-size: 0.78rem;
	}

	.profile-copy {
		max-width: 62rem;
	}

	@media (max-width: 52rem) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}
	}
</style>
