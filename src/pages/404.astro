---
import BaseLayout from "@layouts/BaseLayout.astro";

/** @brief GitHub Pages 使用的双语未找到页面 (Bilingual not-found page for GitHub Pages)。 */
---

<BaseLayout
  locale="zh"
  title="页面未找到 / Page not found"
  description="MoeSegFault：请求的页面不存在。The requested page does not exist."
  robots="noindex"
>
  <section class="not-found surface-card" aria-labelledby="not-found-title">
    <p class="not-found__brand">MoeSegFault</p>
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 id="not-found-title">页面未找到 <span lang="en">/ Page not found</span></h1>
    <p class="not-found__message">
      请求的页面不存在或已经移动。<br />
      <span lang="en">The requested page does not exist or has moved.</span>
    </p>
    <nav class="not-found__actions" aria-label="选择语言 / Choose a language">
      <a class="button" href="/">简体中文首页</a>
      <a class="button button--ghost" href="/en/" lang="en">English home</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    max-width: 46rem;
    margin: clamp(3rem, 12vw, 8rem) auto;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .not-found__brand {
    margin: 0 0 1rem;
    color: var(--coral-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .not-found__code {
    margin: 0 0 0.5rem;
    color: var(--coral);
    font-size: clamp(3.5rem, 14vw, 7rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .not-found h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    line-height: 1.2;
  }

  .not-found h1 span {
    color: var(--text-soft);
  }

  .not-found__message {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--text-soft);
    line-height: 1.8;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
