---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@moesegfault/style/astro/Button.astro";
import CoreMascot from "../components/CoreMascot.astro";
import PixelArt from "../components/PixelArt.astro";
import { CAP_HEIGHT, setType } from "../pixel/typeface";

/** The unmapped address; 0x194 is 404. */
const address = setType("0x194", "moe");
---

<BaseLayout
  locale="zh"
  title="页面未找到 / Page not found"
  description="moeSegFault：请求的页面不存在。The requested page does not exist."
  robots="noindex"
>
  <section class="not-found bleed pad" data-moe-surface="brand" aria-labelledby="not-found-title">
    <CoreMascot mood="dizzy" class="not-found__core" />
    <div class="not-found__copy">
      <PixelArt class="not-found__address" cells={address.cells} columns={address.width} rows={CAP_HEIGHT} />
      <h1 id="not-found-title">页面未找到 <span lang="en">/ Page not found</span></h1>
      <nav class="moe-cluster" aria-label="选择语言 / Choose a language">
        <Button href="/">简体中文首页</Button>
        <Button href="/en/" variant="secondary" lang="en">English home</Button>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  .not-found :global(.not-found__core) {
    width: clamp(9rem, 24vw, 16rem);
  }
  .not-found__copy {
    display: grid;
    justify-items: start;
    gap: var(--moe-space-4);
  }
  .not-found__copy > * {
    margin: 0;
  }
  .not-found :global(.not-found__address) {
    width: min(100%, 22rem);
  }
  .not-found h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
  }
</style>
