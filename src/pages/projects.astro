---
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGitHubProjects } from "../lib/github";

/** @brief 构建期获取并规范化的 GitHub 项目 (GitHub projects fetched and normalized at build time)。 */
const projects = await getGitHubProjects("kleedaisuki");
---

<BaseLayout
  title="Projects"
  description="Klee 的开源项目与实验：系统、并行计算、机器学习，以及仍在生长的想法。"
>
  <section class="projects-hero" aria-labelledby="projects-title">
    <p class="projects-hero__eyebrow">PROJECT ARCHIVE · 开源魔法工房</p>
    <h1 id="projects-title">Projects</h1>
    <p>
      从底层系统到并行计算，从机器学习实验到尚未命名的想法——这里收集了我最近更新的公开项目。
    </p>
    <a href="https://github.com/kleedaisuki" target="_blank" rel="noreferrer">
      在 GitHub 查看全部 <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="projects-list" aria-label="GitHub 项目列表">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>

<style>
  .projects-hero {
    position: relative;
    overflow: hidden;
    margin: 1rem 0 2rem;
    padding: clamp(1.5rem, 4vw, 2.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: linear-gradient(125deg, var(--surface-solid), var(--coral-soft));
    box-shadow: var(--shadow);
  }

  .projects-hero::after {
    position: absolute;
    right: -2.2rem;
    bottom: -3.8rem;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--gold) 55%, transparent), transparent 70%);
    content: "";
    pointer-events: none;
  }

  .projects-hero__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--coral-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .projects-hero h1 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(2.3rem, 8vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .projects-hero > p:not(.projects-hero__eyebrow) {
    max-width: 43rem;
    margin: 1rem 0;
    color: var(--text-soft);
  }

  .projects-hero a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 0.35rem;
    color: var(--coral-strong);
    font-weight: 800;
    text-underline-offset: 0.24em;
  }

  .projects-hero a:focus-visible {
    border-radius: 0.3rem;
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.5rem), 1fr));
    gap: 1.15rem;
    margin-bottom: 2rem;
  }
</style>
