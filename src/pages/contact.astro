---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactCard from "../components/ContactCard.astro";
import { contacts } from "../data/contacts";

/** @brief 联系页面的文档标题。Document title for the contact page. */
const title = "联系我";
/** @brief 联系页面的搜索与分享摘要。Search and sharing summary for the contact page. */
const description = "通过 GitHub、个人主页、博客与 Bot 找到 kleedaisuki。";
---

<BaseLayout {title} {description}>
  <div class="contact-page">
    <header class="intro">
      <p class="eyebrow">CONTACT</p>
      <h1>保持联系 <span aria-hidden="true">✦</span></h1>
      <p class="lede">
        这里汇集了我目前公开的网络入口。选择一个合适的频道，继续探索代码、文章与项目。
      </p>
    </header>

    <section class="contact-grid" aria-label="公开联系方式">
      {contacts.map((contact) => <ContactCard {contact} />)}
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    width: min(100% - 2rem, 70rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .intro {
    max-width: 43rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--coral-strong);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  h1 span {
    color: var(--coral);
    font-size: 0.65em;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1rem, 2vw, 1.14rem);
    line-height: 1.8;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 43rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
