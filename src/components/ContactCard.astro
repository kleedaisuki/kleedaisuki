---
import Icon from "@moesegfault/style/astro/Icon.astro";
import type { PublicLink } from "../data/contacts";
import { getMessages, type Locale } from "../i18n";

interface Props {
  contact: PublicLink;
  locale: Locale;
}

const { contact, locale } = Astro.props;
const t = getMessages(locale).contact;
const label = contact.label[locale];
const channel = contact.kind === "contact";
const preferred = channel && contact.preferred;
/** Distinguish a platform visit from a contact action for assistive technology. */
const name = channel
  ? `${t.openLink}: ${label}, ${contact.display}${preferred ? `, ${t.preferred}` : ""}`
  : `${t.openPlatform}: ${label}`;
---

<a
  class="contact-card"
  href={contact.href}
  data-channel={channel ? contact.id : undefined}
  data-platform={channel ? undefined : contact.id}
  data-preferred={preferred || undefined}
  aria-label={name}
>
  <strong>{label}</strong>
  <Icon name="arrow-up-right" size={18} />
  {
    channel ? (
      <span class="address">{contact.display}</span>
    ) : (
      <span class="description">{contact.description[locale]}</span>
    )
  }
</a>

<style>
  .contact-card {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 8rem;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto;
    gap: var(--moe-space-3);
    padding: var(--moe-space-5);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--moe-motion-fast) var(--moe-motion-ease-standard);
  }
  .contact-card:is(:hover, :focus-visible) {
    background: var(--moe-surface-sunken);
  }
  .contact-card:focus-visible {
    outline-offset: -3px;
  }
  /* The preferred channel keeps the edge that the others only show when touched. */
  .contact-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--moe-accent);
    content: "";
    scale: 1 0;
    transition: scale var(--moe-spring);
  }
  .contact-card:is(:hover, :focus-visible, [data-preferred])::before {
    scale: 1;
  }
  .contact-card strong {
    color: var(--moe-heading);
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
    transform-origin: 0 0;
    transition: scale var(--moe-spring);
  }
  .contact-card:active strong {
    scale: var(--moe-press);
    transition-duration: 60ms;
  }
  .address,
  .description {
    grid-column: 1 / -1;
    color: var(--moe-text-soft);
    font-size: var(--moe-font-size-sm);
  }
  .address {
    font-family: var(--moe-font-family-mono);
    font-size: 0.8125rem;
  }
  .contact-card :global(.moe-icon) {
    color: var(--moe-text-soft);
    transition:
      translate var(--moe-spring),
      color var(--moe-motion-fast) var(--moe-motion-ease-standard);
  }
  .contact-card:is(:hover, :focus-visible) :global(.moe-icon) {
    color: var(--moe-accent-strong);
    translate: 0.2em -0.2em;
  }
</style>
