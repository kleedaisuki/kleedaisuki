---
import type { PublicLink } from "../data/contacts";
import { getMessages, type Locale } from "../i18n";

/** Public-destination card properties for contacts and platforms. */
interface Props {
  /** Public destination to render. */
  contact: PublicLink;
  /** @brief 当前页面语言 (Active page locale)。 */
  locale: Locale;
}

/** @brief 当前卡片的联系方式数据 (Contact data for the current card)。 */
const { contact, locale } = Astro.props;
/** @brief 当前语言的站点文案 (Site messages for the active locale)。 */
const t = getMessages(locale);
/** @brief 当前语言的渠道名称 (Localized channel label)。 */
const label = contact.label[locale];
/** @brief 当前语言的渠道说明 (Localized channel description)。 */
const description = contact.description[locale];
/** Distinguish a platform visit from a contact action for assistive technology. */
const actionLabel = contact.kind === "platform" ? t.contact.openPlatform : t.contact.openLink;
/** Complete accessible name for the link. */
const accessibleLabel = `${actionLabel}: ${label} — ${contact.display}`;
---

<a
  class="contact-card"
  href={contact.href}
  data-channel={contact.kind === "contact" ? contact.id : undefined}
  data-platform={contact.kind === "platform" ? contact.id : undefined}
  aria-label={accessibleLabel}
>
  <span class="glyph" aria-hidden="true">{contact.glyph}</span>
  <span class="content">
    <span class="title-row">
      <strong>{label}</strong>
      {
        contact.preferred && (
          <span class="preferred" aria-label={t.contact.preferred}>
            {t.contact.preferred}
          </span>
        )
      }
      <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5 15 15 5m-7 0h7v7"></path>
      </svg>
    </span>
    <span class="description">{description}</span>
    <span class="address">{contact.display}</span>
  </span>
</a>

<style>
  .contact-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.8rem, 2.5vw, 1rem);
    min-width: 0;
    min-height: 10rem;
    padding: clamp(1rem, 3vw, 1.25rem);
    color: var(--text);
    text-decoration: none;
    touch-action: manipulation;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-small);
    -webkit-tap-highlight-color: transparent;
  }

  .contact-card:active {
    background: var(--coral-soft);
    border-color: var(--coral);
  }

  .contact-card:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--coral-strong);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: var(--coral-soft);
    border-radius: 0.9rem;
  }

  .content {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .title-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
  }

  strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 1.08rem;
  }

  .preferred {
    flex: none;
    padding: 0.15rem 0.45rem;
    color: var(--coral-strong);
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1.35;
    background: var(--coral-soft);
    border-radius: 999px;
  }

  .arrow {
    width: 1.15rem;
    flex: none;
    margin-inline-start: auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .description {
    margin-block: 0.55rem auto;
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .address {
    max-width: 100%;
    color: var(--coral-strong);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-card {
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .arrow {
      transition: transform 180ms ease;
    }

    .contact-card:hover {
      transform: translateY(-3px);
      border-color: var(--coral);
      box-shadow: var(--shadow);
    }

    .contact-card:hover .arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 22rem) {
    .contact-card {
      grid-template-columns: 1fr;
    }

    .glyph {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .arrow {
      transition: none;
    }
  }
</style>
