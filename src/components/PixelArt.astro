---
import type { HTMLAttributes } from "astro/types";
import { type Cell, tonePaths } from "../pixel/cell";

interface Props extends Omit<HTMLAttributes<"svg">, "width" | "height"> {
  cells: readonly Cell[];
  columns: number;
  rows: number;
}

const { cells, columns, rows, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  class:list={["pixel-art", className]}
  viewBox={`0 0 ${columns} ${rows}`}
  aria-hidden="true"
  focusable="false"
>
  {tonePaths(cells).map(({ tone, d }) => <path style={`fill:var(--px-${tone})`} {d} />)}
</svg>

<style>
  .pixel-art {
    width: 100%;
    height: auto;
  }
</style>
