---
import Button from "@moesegfault/style/astro/Button.astro";
import Icon from "@moesegfault/style/astro/Icon.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "../../config/site";
import { getMessages, pagePath, type Locale } from "../../i18n";
import { getLocalizedDocument } from "../../i18n/content";
import { parseIdentity } from "../../lib/identity";
import { getProfileSnapshot } from "../../lib/profile-catalog";
import Backtrace from "../Backtrace.astro";
import CoreDump from "../CoreDump.astro";
import GitHubProfileCard from "../GitHubProfileCard.astro";
import MemoryMap from "../MemoryMap.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getMessages(locale);
const metadata = copy.meta.home;
const { markdown } = await getLocalizedDocument("profile", locale);
const fragments = parseIdentity(markdown);
const profileSnapshot = await getProfileSnapshot();
---

<BaseLayout {locale} page="home" title={metadata.title} description={metadata.description}>
  <div class="home">
    <CoreDump {locale} class="home-hero" labelledby="home-title">
      <h1 id="home-title">{copy.home.headline}</h1>
      <p class="lede">{copy.home.introduction}</p>
      <div class="moe-cluster">
        <Button href={SITE.githubUrl} size="lg">
          GitHub
          <Icon slot="trailing" name="arrow-up-right" size={16} />
        </Button>
        <Button href={pagePath("projects", locale)} size="lg" variant="secondary">
          {copy.nav.projects}
        </Button>
      </div>
    </CoreDump>

    <div class="home-workbench moe-blueprint pad">
      <GitHubProfileCard snapshot={profileSnapshot} {locale} copy={copy.home} />
      <MemoryMap {locale} />
    </div>

    <section class="home-profile" aria-label={copy.home.profileLabel}>
      <Backtrace {fragments} />
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    min-width: 0;
  }
  .home h1 {
    font-size: clamp(2.5rem, 5vw, var(--moe-font-size-3xl));
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .home h1:lang(zh) {
    max-width: 7em;
    letter-spacing: -0.02em;
    line-height: 1.16;
  }
  .home-workbench {
    --moe-blueprint-line: color-mix(in srgb, var(--moe-line) 60%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--moe-space-4);
    padding-block: var(--moe-space-6);
    border-block-end: 1px solid var(--moe-line);
  }
  @media (max-width: 64rem) {
    .home-workbench {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
