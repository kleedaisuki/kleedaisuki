---
import ContactCard from "@components/ContactCard.astro";
import { contacts, platforms } from "@data/contacts";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getMessages, type Locale } from "../../i18n";

/** @brief 本地化联系页面属性 (Localized contact-page properties)。 */
interface Props {
  /** @brief 当前页面语言 (Active page locale)。 */
  locale: Locale;
}

/** @brief 当前页面语言 (Active page locale)。 */
const { locale } = Astro.props;
/** @brief 当前语言的站点文案 (Site messages for the active locale)。 */
const t = getMessages(locale);
/** Accessible names for the two distinct destination groups. */
const contactListLabel = `${t.meta.contact.title}: ${t.contact.intro}`;
const platformListLabel = `${t.contact.platformsTitle}: ${t.contact.platformsIntro}`;
---

<BaseLayout {locale} page="contact">
  <article class="contact-page">
    <header class="intro">
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h1>{t.meta.contact.title} <span aria-hidden="true">✦</span></h1>
      <p class="lede">{t.contact.intro}</p>
    </header>

    <ul class="contact-grid" aria-label={contactListLabel}>
      {
        contacts.map((contact) => (
          <li>
            <ContactCard {contact} {locale} />
          </li>
        ))
      }
    </ul>

    <section class="platforms" aria-labelledby="platforms-title">
      <h2 id="platforms-title">{t.contact.platformsTitle}</h2>
      <p>{t.contact.platformsIntro}</p>
      <ul class="contact-grid" aria-label={platformListLabel}>
        {
          platforms.map((platform) => (
            <li>
              <ContactCard contact={platform} {locale} />
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .contact-page {
    width: min(100%, 58rem);
    margin-inline: auto;
    padding-block: clamp(2.75rem, 8vw, 7rem);
  }

  .intro {
    max-width: 43rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--coral-strong);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  h1 span {
    color: var(--coral);
    font-size: 0.65em;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1rem, 2vw, 1.14rem);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1rem);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-grid li {
    min-width: 0;
  }

  .contact-grid li > :global(.contact-card) {
    height: 100%;
  }

  .platforms {
    margin-block-start: clamp(3rem, 7vw, 5rem);
  }

  .platforms h2 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.03em;
  }

  .platforms > p {
    max-width: 43rem;
    margin: 0.65rem 0 1.5rem;
    color: var(--text-soft);
    line-height: 1.7;
  }

  @media (max-width: 44rem) {
    .contact-page {
      padding-block-start: 2.5rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
