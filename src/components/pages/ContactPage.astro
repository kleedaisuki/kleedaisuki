---
import { contacts, type PublicLink, platforms } from "@data/contacts";
import BaseLayout from "@layouts/BaseLayout.astro";
import Grid from "@moesegfault/style/astro/Grid.astro";
import { getMessages, type Locale } from "../../i18n";
import ContactCard from "../ContactCard.astro";
import PageIntro from "../PageIntro.astro";
import RailSection from "../RailSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getMessages(locale);
const groups: readonly {
  id: string;
  title: string;
  links: readonly PublicLink[];
}[] = [
  { id: "channels", title: t.contact.channelsTitle, links: contacts },
  { id: "platforms", title: t.contact.platformsTitle, links: platforms },
];
---

<BaseLayout {locale} page="contact">
  <article class="contact">
    <PageIntro title={t.meta.contact.title} mood="wink" />

    {
      groups.map(({ id, title, links }) => (
        <RailSection id={`${id}-title`} class={id} {title}>
          <Grid ruled min="22rem">
            {links.map((contact) => <ContactCard {contact} {locale} />)}
          </Grid>
        </RailSection>
      ))
    }
  </article>
</BaseLayout>

<style>
  .contact > :global(:last-child) {
    border-block-end: 0;
  }
</style>
