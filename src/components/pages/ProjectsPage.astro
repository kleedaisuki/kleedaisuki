---
import Button from "@moesegfault/style/astro/Button.astro";
import Icon from "@moesegfault/style/astro/Icon.astro";
import Notice from "@moesegfault/style/astro/Notice.astro";
import { SITE } from "../../config/site";
import { PROJECT_COPY } from "../../data/project-copy";
import { getMessages, type Locale } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectDirectory } from "../../lib/project-catalog";
import { countLanguages, groupByMonth, languageHue } from "../../lib/project-index";
import PageIntro from "../PageIntro.astro";
import ProjectCard from "../ProjectCard.astro";
import RailSection from "../RailSection.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const message = getMessages(locale);
const copy = PROJECT_COPY[locale];
const { projects, source } = await getProjectDirectory();
const months = groupByMonth(projects);
const languages = countLanguages(projects);
const live = source === "github";
const monthName = new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-US", {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
---

<BaseLayout {locale} page="projects">
  <div class="projects" data-projects>
    <PageIntro title={copy.title} mood="starry">
      <Button href={SITE.githubUrl} aria-label={copy.viewAll}>
        GitHub
        <Icon slot="trailing" name="arrow-up-right" size={16} />
      </Button>
    </PageIntro>

    {
      !live && (
        <div class="projects__notice pad">
          <Notice tone="warning" title={message.projects.sourceFallback} role="status">
            {copy.fallbackNotice}
          </Notice>
        </div>
      )
    }

    <div class="heap pad">
      <nav class="heap__map" aria-label={copy.listLabel}>
        {
          projects.map(({ name, language }) => (
            <a href={`#project-${name}`} data-language={language} style={`--hue:${languageHue(language)}`}>
              <span>{name}</span>
            </a>
          ))
        }
      </nav>
      <ul class="heap__legend" aria-label={copy.languagesLabel}>
        {
          languages.map(({ language, count }) => (
            <li>
              <button type="button" data-language={language} aria-pressed="false" style={`--hue:${languageHue(language)}`}>
                {language} <b>{count}</b>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    {
      months.map(({ month, projects: group }) => (
        <RailSection id={`month-${month}`} title={monthName.format(new Date(`${month}-01`))}>
          <ul class="projects__grid">
            {group.map((project) => (
              <li
                data-project
                data-language={project.language}
                style={`--card:project-${projects.indexOf(project)}`}
              >
                <ProjectCard {project} {locale} />
              </li>
            ))}
          </ul>
        </RailSection>
      ))
    }
  </div>
</BaseLayout>

<script>
  import "../../scripts/project-heap";
</script>

<style>
  .projects {
    min-width: 0;
  }
  .projects__notice {
    padding-block: var(--moe-space-5);
    border-block-end: 1px solid var(--moe-line);
  }
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--moe-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects > :global(section:not(:has(li:not([hidden])))) {
    display: none;
  }
  /* The footer rules off whichever month is last in view. */
  .projects > :global(section:not(:has(~ section li:not([hidden])))) {
    border-block-end: 0;
  }
  :global(:root[data-heap-shift]) .projects__grid li {
    view-transition-name: var(--card);
  }

  /* One block per repository, newest first: the directory as a heap. */
  .heap {
    position: relative;
    display: grid;
    gap: var(--moe-space-4);
    padding-block: 2.5rem var(--moe-space-4);
    border-block-end: 1px solid var(--moe-line);
    background: var(--moe-surface-sunken);
  }
  .heap__map {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
    gap: 4px;
  }
  .heap__map a {
    height: 2.75rem;
  }
  /* The block moves and the link does not, so a rising block never slips from under the pointer. */
  .heap__map a::before {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--hue);
    content: "";
    transition:
      translate var(--moe-spring),
      scale var(--moe-spring),
      border-radius var(--moe-spring),
      opacity var(--moe-motion-base) var(--moe-motion-ease-standard);
  }
  .heap__map a:is(:hover, :focus-visible)::before {
    border-radius: var(--moe-radius-sm);
    translate: 0 -6px;
  }
  .heap__map a:is(:hover, :focus-visible) + a::before,
  .heap__map a:has(+ a:is(:hover, :focus-visible))::before {
    translate: 0 -2px;
  }
  .heap__map a:active::before {
    scale: var(--moe-press);
    translate: 0 0;
  }
  .heap__map a[data-away]::before {
    opacity: 0.18;
  }
  /* Every name is written in the same spot; only the touched one is shown. */
  .heap__map span {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline: var(--site-gutter);
    overflow: hidden;
    color: var(--moe-heading);
    font-family: var(--moe-font-family-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    opacity: 0;
    pointer-events: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .heap__map a:is(:hover, :focus-visible) span {
    opacity: 1;
  }
  /* A name under the pointer wins over the one left focused. */
  .heap__map:hover a:not(:hover) span {
    opacity: 0;
  }
  .heap__legend {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -0.625rem;
    padding: 0;
    list-style: none;
  }
  .heap__legend button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.625rem;
    border: 0;
    color: var(--moe-text-soft);
    background: none;
    cursor: pointer;
    font-family: var(--moe-font-family-mono);
    font-size: var(--moe-font-size-xs);
    transition: color var(--moe-motion-fast) var(--moe-motion-ease-standard);
  }
  .heap__legend button::before {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--hue);
    content: "";
    transition:
      rotate var(--moe-bounce),
      scale var(--moe-bounce);
  }
  .heap__legend button:is(:hover, [aria-pressed="true"]) {
    color: var(--moe-heading);
  }
  .heap__legend button:hover::before {
    scale: 1.3;
  }
  .heap__legend button:active::before {
    scale: 0.7;
  }
  .heap__legend button[aria-pressed="true"]::before {
    rotate: 45deg;
    scale: 1.3;
  }
  .heap__legend:has([aria-pressed="true"]) button[aria-pressed="false"]:not(:hover)::before {
    opacity: 0.35;
  }
  .heap__legend b {
    color: var(--moe-heading);
  }
  @media (scripting: none) {
    .heap__legend {
      display: none;
    }
  }
</style>
