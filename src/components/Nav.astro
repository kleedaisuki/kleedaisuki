---
import BrandMark from "@moesegfault/style/astro/BrandMark.astro";
import Icon from "@moesegfault/style/astro/Icon.astro";
import { SITE } from "../config/site";
import {
  alternateLocale,
  getMessages,
  localeFromUrl,
  localeMetadata,
  pagePath,
  type Locale,
  type PageId,
} from "../i18n";

/** @brief 导航组件属性 (Navigation component properties)。 */
interface Props {
  /** @brief 当前页面语言 (Active page locale)。 */
  locale?: Locale;
  /** @brief 当前页面标识 (Current page identifier)。 */
  page?: PageId;
}

/** @brief 当前页面语言 (Active page locale)。 */
const locale = Astro.props.locale ?? localeFromUrl(Astro.url);
/** @brief 当前语言文案 (Messages for the active locale)。 */
const copy = getMessages(locale);
/** @brief 站点一级页面的稳定顺序 (Stable order of primary site pages)。 */
const pages = ["home", "uses", "now", "projects", "contact"] as const satisfies readonly PageId[];
/** @brief 去除语言前缀与尾斜杠后的路径 (Path without locale prefix or trailing slash)。 */
const localPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "").replace(/\/+$/, "") || "/";
/** @brief 由当前路径推导的页面标识 (Page identifier inferred from the current path)。 */
const inferredPage = pages.find(
  (page) => (pagePath(page, "zh").replace(/\/+$/, "") || "/") === localPath,
);
/** @brief 当前页面标识 (Current page identifier)。 */
const page = Astro.props.page ?? inferredPage;
/** @brief 目标切换语言 (Destination locale for the language switch)。 */
const targetLocale = alternateLocale(locale);
/** @brief 语言切换地址，未知页面回到目标语言首页 (Language-switch destination, falling back to the target-language home for unknown pages)。 */
const languageHref = page ? pagePath(page, targetLocale) : pagePath("home", targetLocale);

/**
 * @brief 判断页面是否为当前页面 (Determine whether a page is current)。
 * @param candidate 待判断的页面标识 (Candidate page identifier)。
 * @return 页面是否处于当前状态 (Whether the page is current)。
 */
const isCurrent = (candidate: PageId): boolean => page === candidate;
---

<header class="site-header">
  <div class="site-header__inner frame pad">
    <BrandMark class="site-brand" href={pagePath("home", locale)} aria-label={copy.brand.homeLabel}>
      {SITE.name}
    </BrandMark>

    <nav class="site-nav" aria-label={copy.common.primaryNavigation}>
      {pages.map((item) => (
        <a href={pagePath(item, locale)} aria-current={isCurrent(item) ? "page" : undefined}>
          {copy.nav[item]}
          {isCurrent(item) && <span class="site-nav__mark" aria-hidden="true" />}
        </a>
      ))}
    </nav>

    <div class="site-actions">
      <a
        class="language-switch moe-button moe-button--ghost"
        href={languageHref}
        lang={localeMetadata[targetLocale].languageTag}
        hreflang={localeMetadata[targetLocale].languageTag}
        aria-label={`${copy.common.languageSwitcher}: ${copy.common.switchLanguage}`}
        title={copy.common.switchLanguage}
      >
        {targetLocale === "en" ? "EN" : "中"}
      </a>
      <button
        class="theme-toggle moe-button moe-button--ghost moe-draw"
        type="button"
        data-icon-only
        data-theme-toggle={SITE.themeStorageKey}
        data-light-label={copy.common.lightTheme}
        data-dark-label={copy.common.darkTheme}
        data-to-light={copy.common.switchToLight}
        data-to-dark={copy.common.switchToDark}
        aria-label={copy.common.themeToggle}
        aria-pressed="false"
      >
        <Icon name="moon" size={16} class="theme-toggle__moon" />
        <Icon name="sun" size={16} class="theme-toggle__sun" />
        <span class="moe-visually-hidden" aria-live="polite" data-theme-status></span>
      </button>
    </div>
  </div>
</header>

<script>
  import "../scripts/theme";
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-block-end: 1px solid var(--moe-line);
    background: var(--moe-background);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    height: var(--site-header);
    align-items: center;
    column-gap: var(--moe-space-5);
  }
  .site-nav {
    display: flex;
    height: 100%;
  }
  .site-nav a {
    position: relative;
    display: flex;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.75rem;
    color: var(--moe-text-soft);
    font-size: var(--moe-font-size-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--moe-motion-base) var(--moe-motion-ease-standard);
  }
  .site-nav a::after,
  .site-nav__mark {
    position: absolute;
    inset: auto 0.75rem 0;
    height: 2px;
    background: var(--moe-line-strong);
    content: "";
  }
  .site-nav a::after {
    scale: 0 1;
    transition: scale var(--moe-spring);
  }
  .site-nav a:hover::after {
    scale: 1;
  }
  .site-nav a:active::after {
    background: var(--moe-accent);
  }
  .site-nav__mark {
    z-index: 1;
    background: var(--moe-accent);
  }
  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--moe-heading);
  }
  .site-nav a:focus-visible {
    outline-offset: -3px;
  }
  .site-actions {
    display: flex;
    --moe-control-md: 2.75rem;
  }
  .language-switch {
    min-width: 2.75rem;
    font-family: var(--moe-font-family-mono);
  }
  /* Both sit in one cell; one sets as the other rises. */
  .theme-toggle {
    display: inline-grid;
    --moon: 1;
    --sun: 0;
  }
  .theme-toggle :global(.moe-icon) {
    grid-area: 1 / 1;
    transition:
      rotate var(--moe-bounce),
      scale var(--moe-bounce),
      opacity var(--moe-motion-fast) var(--moe-motion-ease-standard);
  }
  .theme-toggle :global(.theme-toggle__moon) {
    opacity: var(--moon);
    rotate: calc((1 - var(--moon)) * 120deg);
    scale: calc(0.3 + 0.7 * var(--moon));
  }
  .theme-toggle :global(.theme-toggle__sun) {
    opacity: var(--sun);
    rotate: calc((1 - var(--sun)) * -120deg);
    scale: calc(0.3 + 0.7 * var(--sun));
  }
  :global(:root[data-moe-theme="dark"]) .theme-toggle {
    --moon: 0;
    --sun: 1;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root[data-moe-theme="auto"]) .theme-toggle {
      --moon: 0;
      --sun: 1;
    }
  }
  /* Phones get the five pages on a row of their own. */
  @media (max-width: 52rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: var(--site-header) 2.75rem;
      height: auto;
    }
    .site-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--site-gutter));
      border-block-start: 1px solid var(--moe-line);
    }
    .site-nav a {
      flex: 1;
      padding-inline: 0.25rem;
    }
  }
</style>
