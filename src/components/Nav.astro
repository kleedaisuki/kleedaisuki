---
import { SITE } from "../config/site";
import {
  alternateLocale,
  getMessages,
  localeFromUrl,
  localeMetadata,
  pagePath,
  type Locale,
  type PageId,
} from "../i18n";

/** @brief 导航组件属性 (Navigation component properties)。 */
interface Props {
  /** @brief 当前页面语言 (Active page locale)。 */
  locale?: Locale;
  /** @brief 当前页面标识 (Current page identifier)。 */
  page?: PageId;
}

/** @brief 当前页面语言 (Active page locale)。 */
const locale = Astro.props.locale ?? localeFromUrl(Astro.url);
/** @brief 当前语言文案 (Messages for the active locale)。 */
const copy = getMessages(locale);
/** @brief 站点一级页面的稳定顺序 (Stable order of primary site pages)。 */
const pages = ["home", "uses", "now", "projects", "contact"] as const satisfies readonly PageId[];
/** @brief 去除语言前缀与尾斜杠后的路径 (Path without locale prefix or trailing slash)。 */
const localPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "").replace(/\/+$/, "") || "/";
/** @brief 由当前路径推导的页面标识 (Page identifier inferred from the current path)。 */
const inferredPage = pages.find(
  (page) => (pagePath(page, "zh").replace(/\/+$/, "") || "/") === localPath,
);
/** @brief 当前页面标识 (Current page identifier)。 */
const page = Astro.props.page ?? inferredPage;
/** @brief 目标切换语言 (Destination locale for the language switch)。 */
const targetLocale = alternateLocale(locale);
/** @brief 语言切换地址，未知页面回到目标语言首页 (Language-switch destination, falling back to the target-language home for unknown pages)。 */
const languageHref = page ? pagePath(page, targetLocale) : pagePath("home", targetLocale);

/**
 * @brief 判断页面是否为当前页面 (Determine whether a page is current)。
 * @param candidate 待判断的页面标识 (Candidate page identifier)。
 * @return 页面是否处于当前状态 (Whether the page is current)。
 */
const isCurrent = (candidate: PageId): boolean => page === candidate;
---

<div class="nav-shell">
  <a class="site-brand" href={pagePath("home", locale)} aria-label={copy.brand.homeLabel}>
    <span class="site-brand__mark" aria-hidden="true">MS</span>
    <span class="site-brand__text">{SITE.name}</span>
  </a>

  <nav class="site-nav" aria-label={copy.common.primaryNavigation}>
    {pages.map((item) => (
      <a href={pagePath(item, locale)} aria-current={isCurrent(item) ? "page" : undefined}>
        {copy.nav[item]}
      </a>
    ))}
  </nav>

  <div class="nav-actions">
    <a
      class="language-switch"
      href={languageHref}
      lang={localeMetadata[targetLocale].languageTag}
      hreflang={localeMetadata[targetLocale].languageTag}
      aria-label={`${copy.common.languageSwitcher}: ${copy.common.switchLanguage}`}
      title={copy.common.switchLanguage}
    >
      {targetLocale === "en" ? "EN" : "中"}
    </a>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-light-label={copy.common.lightTheme}
      data-dark-label={copy.common.darkTheme}
      data-to-light={copy.common.switchToLight}
      data-to-dark={copy.common.switchToDark}
      aria-label={copy.common.themeToggle}
      aria-pressed="false"
      title={copy.common.switchToDark}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path data-theme-icon="moon" d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
        <path data-theme-icon="sun" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4L17 7M7 17l-1.4 1.4m12.8 0L17 17M7 7 5.6 5.6M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"></path>
      </svg>
      <span class="theme-toggle__label" data-theme-label>{copy.common.lightTheme}</span>
      <span class="visually-hidden" aria-live="polite" data-theme-status></span>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    /** @brief 主题本地存储键 (Local-storage key for the theme)。 */
    const storageKey = "site-theme";
    /** @brief 文档根元素 (Document root element)。 */
    const root = document.documentElement;
    /** @brief 主题按钮 (Theme toggle button)。 */
    const toggle = document.querySelector("[data-theme-toggle]");
    if (!(toggle instanceof HTMLButtonElement)) return;

    /** @brief 按钮可见标签 (Visible toggle label)。 */
    const label = toggle.querySelector("[data-theme-label]");
    /** @brief 辅助技术播报区域 (Assistive-technology live region)。 */
    const status = toggle.querySelector("[data-theme-status]");
    /** @brief 浏览器主题颜色元数据 (Browser theme-color metadata)。 */
    const themeColor = document.querySelector('meta[name="theme-color"]');
    /** @brief 本地化主题文案 (Localized theme labels)。 */
    const labels = {
      light: toggle.dataset.lightLabel || "Light",
      dark: toggle.dataset.darkLabel || "Dark",
      toLight: toggle.dataset.toLight || "Switch to light theme",
      toDark: toggle.dataset.toDark || "Switch to dark theme",
    };

    /**
     * @brief 应用主题并同步控件状态 (Apply a theme and synchronize control state)。
     * @param {"light" | "dark"} theme 要应用的主题 (Theme to apply)。
     * @param {boolean} announce 是否播报变化 (Whether to announce the change)。
     * @return {void} 无返回值 (No return value)。
     */
    const applyTheme = (theme, announce = false) => {
      /** @brief 当前主题是否为夜间 (Whether the active theme is dark)。 */
      const dark = theme === "dark";
      root.dataset.theme = dark ? "dark" : "light";
      root.style.colorScheme = dark ? "dark" : "light";
      toggle.setAttribute("aria-pressed", String(dark));
      toggle.title = dark ? labels.toLight : labels.toDark;
      if (label) label.textContent = dark ? labels.dark : labels.light;
      if (status && announce) status.textContent = dark ? labels.dark : labels.light;
      if (themeColor instanceof HTMLMetaElement) themeColor.content = dark ? "#21130f" : "#fff6ea";
    };

    applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
    toggle.addEventListener("click", () => {
      /** @brief 用户选择的下一主题 (Next theme selected by the user)。 */
      const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
      try { localStorage.setItem(storageKey, nextTheme); } catch { /* 受限容器仍允许本页切换 (Keep in-page switching in restricted containers). */ }
      applyTheme(nextTheme, true);
    });
  })();
</script>

<style>
  .nav-shell { display: flex; align-items: center; gap: .75rem; min-width: 0; }
  .site-brand { display: inline-flex; flex: none; align-items: center; gap: .55rem; min-height: 44px; color: var(--heading); font-weight: 700; text-decoration: none; }
  .site-brand__mark { display: grid; width: 2.4rem; aspect-ratio: 1; place-items: center; border-radius: 11px; color: #fffaf2; background: linear-gradient(145deg, var(--coral), var(--coral-strong)); box-shadow: 0 6px 14px rgba(190, 69, 37, .22); font-size: .7rem; letter-spacing: -.04em; }
  .site-brand__text { font-size: 1.04rem; }
  .site-nav { display: flex; flex: 1; justify-content: center; gap: .1rem; min-width: 0; }
  .site-nav a, .theme-toggle, .language-switch { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; padding: .45rem .68rem; border: 1px solid transparent; border-radius: 999px; color: var(--text-soft); background: transparent; font: inherit; font-size: .9rem; font-weight: 700; text-decoration: none; cursor: pointer; transition: color var(--motion-fast) var(--ease), background var(--motion-fast) var(--ease), transform var(--motion-fast) var(--ease); }
  .site-nav a[aria-current="page"] { border-color: var(--border); color: var(--coral-strong); background: var(--surface-solid); box-shadow: inset 0 -2px 0 var(--gold); }
  .nav-actions { display: flex; flex: none; align-items: center; gap: .3rem; }
  .theme-toggle, .language-switch { border-color: var(--border); background: var(--surface-solid); }
  .theme-toggle { gap: .38rem; }
  .theme-toggle svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  [data-theme-icon="sun"] { display: none; }
  :global(:root[data-theme="dark"]) [data-theme-icon="sun"] { display: initial; }
  :global(:root[data-theme="dark"]) [data-theme-icon="moon"] { display: none; }
  .visually-hidden { position: absolute; overflow: hidden; width: 1px; height: 1px; padding: 0; margin: -1px; border: 0; clip: rect(0 0 0 0); white-space: nowrap; }
  @supports (color: color-mix(in srgb, white, black)) {
    .site-brand__mark { box-shadow: 0 6px 14px color-mix(in srgb, var(--coral) 30%, transparent); }
    .site-nav a[aria-current="page"] { border-color: color-mix(in srgb, var(--border) 78%, transparent); box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--gold) 70%, transparent); }
    .theme-toggle, .language-switch { border-color: color-mix(in srgb, var(--border) 70%, transparent); }
  }
  @media (hover: hover) and (pointer: fine) {
    .site-brand:hover, .site-nav a:hover, .theme-toggle:hover, .language-switch:hover { color: var(--coral-strong); }
    .site-nav a:hover, .theme-toggle:hover, .language-switch:hover { background: var(--coral-soft); transform: translateY(-1px); }
  }
  @media (max-width: 900px) {
    .nav-shell { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
    .site-nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; overflow-x: auto; padding-top: .35rem; border-top: 1px solid var(--border); scrollbar-width: none; overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; }
    .site-nav::-webkit-scrollbar { display: none; }
    .site-nav a { flex: 1 0 auto; }
  }
  @media (max-width: 430px) {
    .site-brand__text { max-width: 9.5rem; overflow: hidden; text-overflow: ellipsis; }
    .theme-toggle__label { display: none; }
    .theme-toggle { padding-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .site-nav a, .theme-toggle, .language-switch { transition: none; } }
</style>
