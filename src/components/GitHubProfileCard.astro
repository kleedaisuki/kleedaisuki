---
import type { Locale } from "../i18n";
import type { Messages } from "../i18n/types";
import type { GitHubProfileSnapshot } from "../lib/github-profile";

/** @brief GitHub 公开资料卡片属性 (Public GitHub profile-card properties)。 */
interface Props {
  /** @brief 构建期取得的资料快照 (Profile snapshot resolved at build time)。 */
  snapshot: GitHubProfileSnapshot;
  /** @brief 当前页面语言 (Active page locale)。 */
  locale: Locale;
  /** @brief 当前语言的首页文案 (Home-page copy for the active locale)。 */
  copy: Messages["home"];
}

/** @brief 当前 GitHub 资料快照 (Active GitHub profile snapshot)。 */
const { snapshot, locale, copy } = Astro.props;
/** @brief 规范化后的公开资料 (Normalized public profile)。 */
const { profile } = snapshot;
/** @brief 与页面语言一致的加入年份文本 (Localized GitHub join-year text)。 */
const joinedYear = new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en", {
  year: "numeric",
}).format(new Date(profile.createdAt));
/** @brief 适合紧凑展示的个人主页地址 (Compact website address for display)。 */
const displayBlog = profile.blog?.replace(/^https?:\/\//, "").replace(/\/$/, "");
/** @brief 资料简介在当前页面中的语言标记 (Language annotation for the profile biography)。 */
const bioLanguage =
  locale === "zh" && profile.bio && !/\p{Script=Han}/u.test(profile.bio) ? "en" : undefined;
/** @brief GitHub 公开统计数据 (Public GitHub statistics)。 */
const statistics = [
  { id: "repositories", value: profile.publicRepositories, label: copy.repositories },
  { id: "followers", value: profile.followers, label: copy.followers },
  { id: "following", value: profile.following, label: copy.following },
] as const;
---

<aside
  class="github-profile"
  aria-labelledby="github-profile-name"
  data-reveal
  data-github-profile
  data-profile-state="static"
  data-profile-endpoint="/api/github/profile"
  data-profile-fallback-endpoint={`https://api.github.com/users/${encodeURIComponent(profile.login)}`}
  data-profile-locale={locale === "zh" ? "zh-CN" : "en"}
  data-profile-live-label={copy.githubLive}
  data-profile-static-label={copy.githubSnapshot}
  data-profile-avatar-suffix={locale === "zh" ? " 的 GitHub 头像" : "'s GitHub avatar"}
>
  <header class="github-profile__header">
    <img
      class="github-profile__avatar"
      src={profile.avatarUrl}
      width="96"
      height="96"
      alt={
        locale === "zh"
          ? `${profile.name ?? profile.login} 的 GitHub 头像`
          : `${profile.name ?? profile.login}'s GitHub avatar`
      }
      loading="eager"
      fetchpriority="high"
      data-profile-avatar
    />
    <div class="github-profile__identity">
      <span class="github-profile__source" aria-live="polite">
        <span aria-hidden="true"></span>
        <span data-profile-source-label>{copy.githubSnapshot}</span>
      </span>
      <h2 id="github-profile-name" data-profile-name>{profile.name ?? profile.login}</h2>
      <a href={profile.profileUrl} data-profile-link>
        @<span data-profile-login>{profile.login}</span><span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </header>

  <p class="github-profile__bio" lang={bioLanguage} hidden={!profile.bio} data-profile-bio>
    {profile.bio}
  </p>

  <dl class="github-profile__stats" aria-label={copy.githubProfileLabel}>
    {
      statistics.map((statistic) => (
        <div>
          <dt>{statistic.label}</dt>
          <dd data-profile-stat={statistic.id}>{statistic.value}</dd>
        </div>
      ))
    }
  </dl>

  <footer class="github-profile__metadata">
    <ul>
      <li hidden={!profile.company} data-profile-company>
        <span aria-hidden="true">⌘</span><span data-profile-company-text>{profile.company}</span>
      </li>
      <li hidden={!profile.location} data-profile-location>
        <span aria-hidden="true">⌖</span><span data-profile-location-text>{profile.location}</span>
      </li>
      <li>
        <span aria-hidden="true">◷</span>{copy.joinedGitHub} <span data-profile-joined>{joinedYear}</span>
      </li>
    </ul>
    <a href={profile.blog ?? undefined} hidden={!profile.blog} data-profile-blog>
      <span data-profile-blog-text>{displayBlog}</span><span aria-hidden="true"> ↗</span>
    </a>
  </footer>
</aside>

<script>
  import "../scripts/github-profile";
</script>
