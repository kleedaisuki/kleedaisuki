---
import Badge from "@moesegfault/style/astro/Badge.astro";
import Icon from "@moesegfault/style/astro/Icon.astro";
import { PROJECT_COPY, localizeProjectDescription } from "../data/project-copy";
import { getMessages, type Locale } from "../i18n";
import type { GitHubProject } from "../lib/github";
import { languageHue } from "../lib/project-index";

/** @brief 项目卡片属性 (Project card properties)。 */
interface Props {
  /** @brief 待展示的规范化项目 (Normalized project to display)。 */
  project: GitHubProject;
  /** @brief 当前页面语言 (Current page locale)。 */
  locale: Locale;
}

/** @brief 当前卡片属性 (Properties for the current card)。 */
const { project, locale } = Astro.props as Props;
/** @brief 当前语言的全站文案 (Site messages for the active locale)。 */
const message = getMessages(locale);
/** @brief 当前语言的项目辅助文案 (Project supporting copy for the active locale)。 */
const copy = PROJECT_COPY[locale];
/** @brief 当前项目的简介与语言信息 (Description and language information for the current project)。 */
const description = localizeProjectDescription(project, locale);
/** @brief 当前语言环境下格式化的更新时间 (Update date formatted for the active locale)。 */
const updatedAt = new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-US", {
  dateStyle: "medium",
}).format(new Date(project.updatedAt));
---

<article class="project-card moe-card" id={`project-${project.name}`} data-interactive>
  <h3 class="moe-card__title">
    <a href={project.repositoryUrl} aria-label={`${message.projects.repository}: ${project.name}`}>
      {project.name}
    </a>
  </h3>

  {
    description && (
      <p class="project-card__description" lang={description.lang}>
        {description.text}
      </p>
    )
  }

  {
    project.topics.length > 0 && (
      <ul class="project-card__topics" aria-label={`${copy.topicsLabel}: ${project.name}`}>
        {project.topics.map((topic) => <li><Badge>{topic}</Badge></li>)}
      </ul>
    )
  }

  <footer class="project-card__footer">
    {
      project.language && (
        <span class="project-card__language" style={`--hue:${languageHue(project.language)}`}>
          {project.language}
        </span>
      )
    }
    {project.stars > 0 && <span aria-label={`${message.projects.stars}: ${project.stars}`}>★ {project.stars}</span>}
    {project.forks > 0 && <span aria-label={`${message.projects.forks}: ${project.forks}`}>⑂ {project.forks}</span>}
    <time datetime={project.updatedAt} title={`${message.projects.updatedAt}: ${updatedAt}`}>
      {project.updatedAt.slice(5, 10)}
    </time>
    {
      project.homepage && (
        <a
          class="project-card__homepage"
          href={project.homepage}
          aria-label={`${message.projects.homepage}: ${project.name}`}
        >
          <Icon name="arrow-up-right" size={16} />
        </a>
      )
    }
  </footer>
</article>

<style>
  .project-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: var(--moe-space-3);
    padding: var(--moe-space-5);
    scroll-margin-block-start: calc(var(--site-header) + 1.5rem);
  }
  /* Arriving from the heap: the outline closes in on the card, then its border stays marked. */
  .project-card:target {
    border-color: var(--moe-accent);
    outline: 2px solid transparent;
    outline-offset: 0;
    animation: land 900ms var(--moe-motion-ease-emphasized);
  }
  @keyframes land {
    from {
      outline-color: var(--moe-accent);
      outline-offset: 1rem;
    }
    60% {
      outline-color: var(--moe-accent);
      outline-offset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card:target {
      animation: none;
    }
  }
  .project-card > :where(h3, p, ul) {
    margin: 0;
  }
  .project-card .moe-card__title {
    font-family: var(--moe-font-family-mono);
    font-size: var(--moe-font-size-md);
  }
  .project-card__description {
    color: var(--moe-text-soft);
    font-size: var(--moe-font-size-sm);
  }
  .project-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }
  .project-card__footer {
    display: flex;
    margin-block-start: auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem var(--moe-space-4);
    color: var(--moe-text-soft);
    font-family: var(--moe-font-family-mono);
    font-size: var(--moe-font-size-xs);
  }
  .project-card__language {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .project-card__language::before {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--hue);
    content: "";
  }
  .project-card time {
    margin-inline-start: auto;
  }
  /* Sits above the stretched title link. */
  .project-card__homepage {
    position: relative;
    z-index: 1;
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.875rem;
    place-items: center;
  }
  .project-card__homepage :global(.moe-icon) {
    transition: translate var(--moe-spring);
  }
  .project-card__homepage:is(:hover, :focus-visible) :global(.moe-icon) {
    translate: 0.2em -0.2em;
  }
</style>
